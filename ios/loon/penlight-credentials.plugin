#!name = Penlight Dream Box - UID UUID
#!desc = 远程加载脚本，从自有 BanG Dream 日服请求中本地捕获 UID 与 X-Signature(UUID)
#!author = Penlight Dream Box
#!homepage = https://github.com/Lanyinn-Labs/Penlight-Dream-Box
#!loon_version = 3.5.1(983)

[Script]
request if ${url} ~= /^https:\/\/api\.garupa\.jp\/api\/user\/[0-9]+(?:[\/?]|$)/i then script("https://raw.githubusercontent.com/Lanyinn-Labs/Penlight-Dream-Box/main/ios/common/penlight-credentials.js", "capture") with tag="获取 Garupa UID UUID", timeout=10, requires_body=false, enable=true
generic then script("https://raw.githubusercontent.com/Lanyinn-Labs/Penlight-Dream-Box/main/ios/common/penlight-credentials.js", "show") with tag="显示已保存 UID UUID", timeout=10, enable=true

[Mitm]
hostname = api.garupa.jp
